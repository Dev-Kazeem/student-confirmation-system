# ---------------------------------------------------------------
# Django core
# ---------------------------------------------------------------
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=127.0.0.1,localhost

# ---------------------------------------------------------------
# Database (used only in production / when DATABASE_URL is set)
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# ---------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------
# Email (used in production; dev uses console backend)
# ---------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@udusok.edu.ng

# ---------------------------------------------------------------
# Media storage (Cloudinary — configured in Phase 7)
# ---------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------
# Site
# ---------------------------------------------------------------
SITE_NAME=Usmanu Danfodiyo University, Sokoto — Student Confirmation Portal

NOTIFICATIONS_EMAIL_ENABLED=True
SITE_BASE_URL=http://127.0.0.1:8000